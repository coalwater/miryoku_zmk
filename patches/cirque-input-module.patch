+    bool rotate_90, sleep_en, no_taps, no_secondary_tap, no_glide_extend, x_invert, y_invert;
+    bool no_track_error_comp, no_nerd_comp;
     enum pinnacle_sensitivity sensitivity;
     uint8_t x_axis_z_min, y_axis_z_min;
+    uint32_t recalibrate_idle_ms;
+    uint8_t max_delta;
+    int16_t sleep_interval;
     const struct gpio_dt_spec dr;
 };
 
diff --git a/dts/bindings/input/cirque,pinnacle-common.yaml b/dts/bindings/input/cirque,pinnacle-common.yaml
index caefe3e..b7d8e7c 100644
--- a/dts/bindings/input/cirque,pinnacle-common.yaml
+++ b/dts/bindings/input/cirque,pinnacle-common.yaml
@@ -14,6 +14,16 @@ properties:
     type: boolean
   no-taps:
     type: boolean
+  no-glide-extend:
+    type: boolean
+  recalibrate-idle-ms:
+    type: int
+    default: 0
+    description: |
+      Re-run the sensor's calibration after this many milliseconds with no
+      touch activity. The Pinnacle only calibrates at init, and its baseline
+      drifts with temperature, humidity and anything curing near the sensor,
+      after which tracking degrades until the board is reset. 0 disables.
   sensitivity:
     type: string
     enum:
@@ -29,3 +39,27 @@ properties:
     type: int
     default: 4
 
+  sleep-interval:
+    type: int
+    description: |
+      Value written to the SleepInterval register (0x0C), how often the chip
+      wakes from sleep to look for a finger. Unset leaves the power-on value.
+      Upstream forced 255, which makes the pad unresponsive with sleep on.
+
+  max-delta:
+    type: int
+    description: |
+      Clamp each sample's X/Y delta to +/- this many counts (0 = no clamp).
+      Guards against a single outlier sample being amplified into a screen-wide
+      jump by the host's pointer acceleration curve.
+
+  no-track-error-comp:
+    type: boolean
+    description: |
+      Clear CalConfig1 TRACK_ERROR_COMP_ENABLE. Track-error compensation can
+      fire mid-stroke, and the correction appears as one oversized delta.
+
+  no-nerd-comp:
+    type: boolean
+    description: |
+      Clear CalConfig1 NERD_COMP_ENABLE (noise/ESD/recalibration detection).
