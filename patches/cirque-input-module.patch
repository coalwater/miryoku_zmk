+    /* Clamp absurd single-sample deltas. The pad occasionally emits one sample
+     * an order of magnitude larger than its neighbours; the host's pointer
+     * acceleration curve turns that into a screen-wide fling. Normal motion is
+     * well under this, so the clamp is inert until something goes wrong. */
+    if (config->max_delta > 0) {
+        const int8_t lim = (int8_t)config->max_delta;
+        if (dx > lim || dx < -lim || dy > lim || dy < -lim) {
+            LOG_DBG("Clamping outlier delta %d,%d", dx, dy);
+        }
+        dx = CLAMP(dx, -lim, lim);
+        dy = CLAMP(dy, -lim, lim);
+    }
+
     input_report_rel(dev, INPUT_REL_X, dx, false, K_FOREVER);
     input_report_rel(dev, INPUT_REL_Y, dy, true, K_FOREVER);
 
+    /*
+     * Track whether the pad is actually clear. A timer alone is not enough: in
+     * relative mode a finger resting motionless generates no packets, so "no
+     * packets for N ms" reads identically to "no finger", and recalibrating
+     * then calibrates the finger into the baseline - which is exactly how the
+     * first attempt at idle recalibration made things worse rather than better.
+     *
+     * PINNACLE_Z_IDLE is set to 5 at init, so the chip emits a short run of
+     * all-zero packets when the finger leaves. That run is a positive lift
+     * signal; any real movement clears it again.
+     */
+    if (dx == 0 && dy == 0 && btn == 0) {
+        if (data->zero_run < UINT8_MAX) {
+            data->zero_run++;
+        }
+        if (data->zero_run >= PINNACLE_LIFT_ZERO_PACKETS) {
+            data->saw_lift = true;
+        }
+    } else {
+        data->zero_run = 0;
+        data->saw_lift = false;
+    }
