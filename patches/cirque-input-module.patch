+     * or the finger itself gets calibrated into the baseline. */
+    if (config->recalibrate_idle_ms > 0) {
+        k_work_reschedule(&data->recal_work, K_MSEC(config->recalibrate_idle_ms));
+    }
+
     return;
 }
 
+static int pinnacle_force_recalibrate(const struct device *dev);
+
+static void pinnacle_recal_work_cb(struct k_work *work) {
+    struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+    struct pinnacle_data *data = CONTAINER_OF(dwork, struct pinnacle_data, recal_work);
+    if (!data->saw_lift) {
+        LOG_DBG("Skipping idle recalibration, no lift seen");
+        return;
+    }
+
+    LOG_DBG("Idle recalibration");
+    pinnacle_force_recalibrate(data->dev);
+}
