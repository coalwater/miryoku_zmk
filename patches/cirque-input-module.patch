diff --git a/drivers/input/input_pinnacle.h b/drivers/input/input_pinnacle.h
index ed22e42..c37f6ad 100644
--- a/drivers/input/input_pinnacle.h
+++ b/drivers/input/input_pinnacle.h
@@ -39,6 +39,19 @@
 #define PINNACLE_FEED_CFG2_EN_BTN_SCRL BIT(6) // Enable Button Scroll
 #define PINNACLE_FEED_CFG2_ROTATE_90 BIT(7)   // Swap X & Y
 #define PINNACLE_CAL_CFG 0x07                 // Contains calibration configuration bits.
+/* CalConfig1 bits. Names/values cross-checked against QMK's
+ * drivers/sensors/cirque_pinnacle_regdefs.h. The chip powers up with all five
+ * compensation enables set (0x3e), measured on this pad. */
+#define PINNACLE_CAL_CFG_CALIBRATE BIT(0)
+/* Recalibration takes ~100ms on this part; cap the poll well above that. */
+#define PINNACLE_RECALIBRATE_POLL_MAX 500
+/* Z_IDLE is programmed to 5; require most of that run before trusting a lift. */
+#define PINNACLE_LIFT_ZERO_PACKETS 3
+#define PINNACLE_CAL_CFG_BACKGROUND_COMP BIT(1)
+#define PINNACLE_CAL_CFG_NERD_COMP BIT(2)
+#define PINNACLE_CAL_CFG_TRACK_ERROR_COMP BIT(3)
+#define PINNACLE_CAL_CFG_TAP_COMP BIT(4)
+#define PINNACLE_CAL_CFG_PALM_ERROR_COMP BIT(5)
 #define PINNACLE_PS2_AUX 0x08                 // Contains Data register for PS/2 Aux Control.
 #define PINNACLE_SAMPLE 0x09                  // Sample Rate Number of samples generated per second.
 #define PINNACLE_Z_IDLE 0x0A         // Number of Z=0 packets sent when Z goes from >0 to 0.
@@ -75,9 +88,16 @@
 struct pinnacle_data {
     uint8_t btn_cache;
     bool in_int;
+    /* Lift detection - see pinnacle_report_data. The chip emits Z_IDLE all-zero
+     * packets when the finger leaves, which is the only way to tell "pad is
+     * clear" from "finger resting still" in relative mode: both produce no
+     * motion, so neither produces packets. */
+    uint8_t zero_run;
+    bool saw_lift;
     const struct device *dev;
     struct gpio_callback gpio_cb;
     struct k_work work;
+    struct k_work_delayable recal_work;
 };
 
